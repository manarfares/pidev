{% extends 'front/base.html.twig' %}

{% block title %}Covoiturage - RentAll{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-6">
    <section class="mb-8 text-center">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Covoiturage</h1>
        <p class="mt-2 text-gray-600">Trouvez un trajet ou proposez le votre.</p>
        <div class="mt-4">
            <a href="{{ path('app_covoiturage_create') }}" class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">
                Ajouter un covoiturage
            </a>
        </div>
    </section>

    <section class="mb-8">
        <form method="get" class="grid grid-cols-1 gap-3 md:grid-cols-3">
            <input
                type="text"
                name="depart"
                value="{{ filters.depart }}"
                placeholder="Depart"
                class="rounded-md border border-gray-300 px-3 py-2 text-sm"
            >
            <input
                type="text"
                name="destination"
                value="{{ filters.destination }}"
                placeholder="Destination"
                class="rounded-md border border-gray-300 px-3 py-2 text-sm"
            >
            <button type="submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">
                Rechercher
            </button>
        </form>
    </section>

    <div class="mb-4 text-sm text-gray-600">
        {{ trips|length }} trajet{{ trips|length > 1 ? 's' : '' }} trouve{{ trips|length > 1 ? 's' : '' }}
    </div>

    {% if trips|length > 0 %}
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {% for trip in trips %}
                <article class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
                    <div class="flex items-center justify-between">
                        <h3 class="font-semibold text-gray-900">{{ trip.depart }} -> {{ trip.destination }}</h3>
                        {% set reserved = participantsCountByTrip[trip.id]|default(0) %}
                        {% set remaining = trip.places - reserved %}
                        <span class="text-sm text-gray-600">{{ remaining > 0 ? remaining : 0 }}/{{ trip.places }} places restantes</span>
                    </div>
                    <p class="mt-2 text-sm text-gray-600">{{ trip.dateDepart|date('d/m/Y H:i') }}</p>
                    <p class="mt-1 text-sm text-gray-500">Conducteur: {{ trip.conducteur.email }}</p>
                    <div class="mt-4">
                        {% if app.user and trip.conducteur and app.user.id == trip.conducteur.id %}
                            <span class="inline-flex rounded-md bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600">
                                Votre trajet
                            </span>
                        {% elseif app.user and isBookedByTrip[trip.id]|default(false) %}
                            <div class="flex items-center gap-2">
                                <span class="inline-flex rounded-md bg-green-100 px-3 py-1.5 text-xs font-medium text-green-700">
                                    Deja reserve
                                </span>
                                <form method="post" action="{{ path('app_covoiturage_cancel', {id: trip.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel-covoiturage' ~ trip.id) }}">
                                    <button type="submit" class="rounded-md border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50">
                                        Annuler reservation
                                    </button>
                                </form>
                            </div>
                        {% elseif remaining <= 0 %}
                            <span class="inline-flex rounded-md bg-red-100 px-3 py-1.5 text-xs font-medium text-red-700">
                                Complet
                            </span>
                        {% else %}
                            <form method="post" action="{{ path('app_covoiturage_book', {id: trip.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('book-covoiturage' ~ trip.id) }}">
                                <button type="submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">
                                    Reserver
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-8 text-center text-gray-600">
            Aucun trajet pour le moment.
        </div>
    {% endif %}
</div>
{% endblock %}
