{% extends 'front/base.html.twig' %}

{% block title %}Inscription - RentAll{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-12">
    <div class="max-w-md mx-auto">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-gray-900">Créer un compte</h1>
            <p class="text-gray-600 mt-2">Rejoignez RentAll dès aujourd'hui</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="mb-4 p-4 rounded-lg bg-green-50 border border-green-200 text-green-800">
                {{ message }}
            </div>
        {% endfor %}

        {{ form_start(registrationForm, {'attr': {'class': 'space-y-6', 'data-turbo': 'false'}}) }}
            
            <div>
                {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(registrationForm.email) }}
                {{ form_errors(registrationForm.email, {'attr': {'class': 'text-red-600 text-sm mt-1'}}) }}
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    {{ form_label(registrationForm.prenom, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(registrationForm.prenom) }}
                    {{ form_errors(registrationForm.prenom, {'attr': {'class': 'text-red-600 text-sm mt-1'}}) }}
                </div>

                <div>
                    {{ form_label(registrationForm.nom, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(registrationForm.nom) }}
                    {{ form_errors(registrationForm.nom, {'attr': {'class': 'text-red-600 text-sm mt-1'}}) }}
                </div>
            </div>

            <div>
                {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(registrationForm.plainPassword.first) }}
                {{ form_errors(registrationForm.plainPassword.first, {'attr': {'class': 'text-red-600 text-sm mt-1'}}) }}
            </div>

            <div>
                {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(registrationForm.plainPassword.second) }}
                {{ form_errors(registrationForm.plainPassword.second, {'attr': {'class': 'text-red-600 text-sm mt-1'}}) }}
            </div>

            <div class="flex items-start">
                {{ form_widget(registrationForm.agreeTerms) }}
                <label for="{{ registrationForm.agreeTerms.vars.id }}" class="ml-2 text-sm text-gray-700">
                    J'accepte les <a href="#" class="text-blue-600 hover:text-blue-700">conditions d'utilisation</a> et la <a href="#" class="text-blue-600 hover:text-blue-700">politique de confidentialité</a>
                </label>
            </div>
            {{ form_errors(registrationForm.agreeTerms, {'attr': {'class': 'text-red-600 text-sm mt-1'}}) }}

            <button 
                type="submit" 
                class="w-full py-2 px-4 rounded-md bg-blue-600 text-white font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2"
            >
                S'inscrire
            </button>

        {{ form_end(registrationForm) }}

        <div class="mt-6 text-center">
            <p class="text-sm text-gray-600">
                Vous avez déjà un compte? 
                <a href="{{ path('app_login') }}" class="text-blue-600 hover:text-blue-700 font-medium">Se connecter</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
