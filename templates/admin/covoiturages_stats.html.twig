{% extends 'admin/base.html.twig' %}

{% block title %}Statistiques Covoiturages - RentAdmin{% endblock %}

{% block body %}
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-bold text-dark font-heading">Statistiques Covoiturages</h1>
        <p class="text-gray-500 mt-1">Repartition des trajets par ville de depart et destination.</p>
    </div>
    <div>
        <a href="{{ path('admin_covoiturages') }}" class="px-3 py-2 border border-gray-200 rounded-lg text-sm hover:bg-gray-50">Retour a la liste</a>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="rounded-xl bg-white p-5 shadow-sm">
        <p class="text-sm text-gray-500">Total covoiturages</p>
        <p class="mt-2 text-3xl font-bold text-dark">{{ stats.total|default(0) }}</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-200">
            <h2 class="font-semibold text-dark">Top villes de depart</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ville</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Trajets</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for row in stats.by_depart|default([]) %}
                        <tr>
                            <td class="px-4 py-3 text-sm text-gray-700">{{ row.city }}</td>
                            <td class="px-4 py-3 text-sm text-gray-700 text-right">{{ row.total }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="px-4 py-8 text-center text-gray-500">Aucune donnee.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-200">
            <h2 class="font-semibold text-dark">Top villes de destination</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ville</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Trajets</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for row in stats.by_destination|default([]) %}
                        <tr>
                            <td class="px-4 py-3 text-sm text-gray-700">{{ row.city }}</td>
                            <td class="px-4 py-3 text-sm text-gray-700 text-right">{{ row.total }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="px-4 py-8 text-center text-gray-500">Aucune donnee.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
