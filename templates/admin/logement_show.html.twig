{% extends 'admin/base.html.twig' %}

{% block title %}{{ logement.titre }} - Admin{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-semibold text-gray-800">Détails du Logement</h1>
        <a href="{{ path('admin_logements') }}" class="px-4 py-2 bg-gray-600 text-white rounded-md hover:bg-gray-700">
            ← Retour
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Main Info -->
                    <div class="lg:col-span-2 space-y-6">
                        <!-- Image and Basic Info -->
                        <div class="bg-white rounded-lg shadow-md overflow-hidden">
                            {% if logement.image %}
                            <img src="{{ logement.image }}" alt="{{ logement.titre }}" class="w-full h-64 object-cover">
                            {% else %}
                            <div class="w-full h-64 bg-gray-200 flex items-center justify-center">
                                <svg class="w-24 h-24 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                                </svg>
                            </div>
                            {% endif %}
                            
                            <div class="p-6">
                                <div class="flex justify-between items-start mb-4">
                                    <div>
                                        <h2 class="text-2xl font-bold text-gray-900">{{ logement.titre }}</h2>
                                        <p class="text-gray-600 mt-1">{{ logement.adresse }}</p>
                                    </div>
                                    {% if logement.disponible %}
                                    <span class="px-3 py-1 text-sm font-semibold rounded-full bg-green-100 text-green-800">
                                        Disponible
                                    </span>
                                    {% else %}
                                    <span class="px-3 py-1 text-sm font-semibold rounded-full bg-red-100 text-red-800">
                                        Indisponible
                                    </span>
                                    {% endif %}
                                </div>

                                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                                    <div class="text-center p-3 bg-gray-50 rounded-lg">
                                        <p class="text-2xl font-bold text-blue-600">{{ logement.prixParNuit|number_format(2, ',', ' ') }} €</p>
                                        <p class="text-sm text-gray-600">par nuit</p>
                                    </div>
                                    <div class="text-center p-3 bg-gray-50 rounded-lg">
                                        <p class="text-2xl font-bold text-gray-900">{{ logement.nombreChambres }}</p>
                                        <p class="text-sm text-gray-600">chambres</p>
                                    </div>
                                    <div class="text-center p-3 bg-gray-50 rounded-lg">
                                        <p class="text-2xl font-bold text-gray-900">{{ logement.capacite ?? 'N/A' }}</p>
                                        <p class="text-sm text-gray-600">personnes</p>
                                    </div>
                                    <div class="text-center p-3 bg-gray-50 rounded-lg">
                                        <p class="text-xl font-bold text-gray-900">{{ logement.type }}</p>
                                        <p class="text-sm text-gray-600">type</p>
                                    </div>
                                </div>

                                <div>
                                    <h3 class="text-lg font-semibold text-gray-900 mb-2">Description</h3>
                                    <p class="text-gray-700">{{ logement.description }}</p>
                                </div>
                            </div>
                        </div>

                        <!-- Reservations -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <h3 class="text-xl font-semibold text-gray-900 mb-4">Réservations ({{ reservations|length }})</h3>
                            
                            {% if reservations|length > 0 %}
                            <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Locataire</th>
                                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Dates</th>
                                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Montant</th>
                                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        {% for reservation in reservations %}
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-4 py-3 text-sm text-gray-900">#{{ reservation.id }}</td>
                                            <td class="px-4 py-3 text-sm text-gray-900">{{ reservation.locataire.email }}</td>
                                            <td class="px-4 py-3 text-sm text-gray-600">
                                                {{ reservation.dateDebut|date('d/m/Y') }} - {{ reservation.dateFin|date('d/m/Y') }}
                                            </td>
                                            <td class="px-4 py-3 text-sm font-medium text-gray-900">{{ reservation.montantTotal|number_format(2, ',', ' ') }} €</td>
                                            <td class="px-4 py-3">
                                                {% if reservation.statut == 'confirmee' %}
                                                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Confirmée</span>
                                                {% elseif reservation.statut == 'en_attente' %}
                                                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">En attente</span>
                                                {% elseif reservation.statut == 'refusee' %}
                                                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Refusée</span>
                                                {% elseif reservation.statut == 'annulee' %}
                                                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Annulée</span>
                                                {% else %}
                                                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">{{ reservation.statut }}</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            {% else %}
                            <p class="text-gray-500 text-center py-4">Aucune réservation pour ce logement</p>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Sidebar -->
                    <div class="space-y-6">
                        <!-- Owner Info -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Propriétaire</h3>
                            <div class="space-y-3">
                                <div>
                                    <p class="text-sm text-gray-600">Email</p>
                                    <p class="text-sm font-medium text-gray-900">{{ logement.proprietaire.email }}</p>
                                </div>
                                {% if logement.proprietaire.nom %}
                                <div>
                                    <p class="text-sm text-gray-600">Nom</p>
                                    <p class="text-sm font-medium text-gray-900">{{ logement.proprietaire.prenom }} {{ logement.proprietaire.nom }}</p>
                                </div>
                                {% endif %}
                                <div>
                                    <p class="text-sm text-gray-600">Rôle</p>
                                    <p class="text-sm font-medium text-gray-900">
                                        {% if 'ROLE_HOST' in logement.proprietaire.roles %}
                                        Hôte
                                        {% elseif 'ROLE_ADMIN' in logement.proprietaire.roles %}
                                        Administrateur
                                        {% else %}
                                        Utilisateur
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Actions</h3>
                            <div class="space-y-3">
                                <form method="post" action="{{ path('admin_logement_toggle_disponibilite', {id: logement.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle-disponibilite' ~ logement.id) }}">
                                    <button type="submit" class="w-full px-4 py-2 bg-yellow-600 text-white rounded-md hover:bg-yellow-700">
                                        {% if logement.disponible %}
                                        Marquer comme indisponible
                                        {% else %}
                                        Marquer comme disponible
                                        {% endif %}
                                    </button>
                                </form>

                                <a href="{{ path('app_logement_show', {id: logement.id}) }}" target="_blank" 
                                   class="block w-full px-4 py-2 bg-blue-600 text-white text-center rounded-md hover:bg-blue-700">
                                    Voir sur le site
                                </a>

                                <form method="post" action="{{ path('admin_logement_delete', {id: logement.id}) }}" 
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce logement ? Cette action est irréversible.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ logement.id) }}">
                                    <button type="submit" class="w-full px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700">
                                        Supprimer le logement
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Stats -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Statistiques</h3>
                            <div class="space-y-3">
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Total réservations</span>
                                    <span class="text-sm font-medium text-gray-900">{{ reservations|length }}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Confirmées</span>
                                    <span class="text-sm font-medium text-green-600">
                                        {{ reservations|filter(r => r.statut == 'confirmee')|length }}
                                    </span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">En attente</span>
                                    <span class="text-sm font-medium text-yellow-600">
                                        {{ reservations|filter(r => r.statut == 'en_attente')|length }}
                                    </span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Refusées/Annulées</span>
                                    <span class="text-sm font-medium text-red-600">
                                        {{ reservations|filter(r => r.statut in ['refusee', 'annulee'])|length }}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
